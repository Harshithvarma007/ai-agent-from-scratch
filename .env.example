# Copy to .env and fill in what you use. Nothing here is required for local Ollama.
# Load it with:  set -a; source .env; set +a

# Which provider the CLI, steps and notebook use by default: ollama | gemini | groq | openrouter
AGENT_PROVIDER=ollama
# Override the provider's default model (optional)
# AGENT_MODEL=qwen3.5:4b

# Free hosted tiers (only the one you use)
# GEMINI_API_KEY=       # https://aistudio.google.com/apikey
# GROQ_API_KEY=         # https://console.groq.com/keys
# OPENROUTER_API_KEY=   # https://openrouter.ai/keys

# Where Ollama is (Docker Compose sets this to http://ollama:11434)
# OLLAMA_HOST_URL=http://localhost:11434

# The directory the agent is jailed to (default ./workspace)
# AGENT_WORKSPACE=./workspace
# How run_python executes code: subprocess | docker
# AGENT_SANDBOX=subprocess
# AGENT_RUN_PYTHON_TIMEOUT=25
# Image for --sandbox docker (build Dockerfile.sandbox for pandas support)
# AGENT_DOCKER_IMAGE=analyst-agent-sandbox
# Where each run's trajectory JSON is saved (default ./runs)
# AGENT_RUNS_DIR=./runs

# Web app
# HOST=127.0.0.1
# PORT=8765
