# The image run_python uses with --sandbox docker: Python + pandas/numpy and nothing else.
#   docker build -f Dockerfile.sandbox -t analyst-agent-sandbox .
#   AGENT_DOCKER_IMAGE=analyst-agent-sandbox python -m agent --sandbox docker "..."
# The container runs with no network, no capabilities, a read-only workspace mount, 512 MB RAM.
FROM python:3.12-slim
RUN pip install --no-cache-dir "pandas==3.0.6" "numpy==2.5.3"
